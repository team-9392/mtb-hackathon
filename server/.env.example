# Порт API
PORT=8080
# Адрес, на котором слушает API (0.0.0.0 — чтобы телефон дошёл)
HOST=0.0.0.0

# Supabase: Project URL и service_role key (только на сервере, в мобильное приложение не попадают)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Секреты API
JWT_SECRET=замени-на-длинную-случайную-строку
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# Демо-режим: если задан, код из SMS всегда равен этому значению и возвращается в ответе
DEMO_OTP=1111
DEMO_PHONE_ALLOWLIST=

# CORS для разработки (пусто — разрешено всё)
CORS_ORIGIN=
