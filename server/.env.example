# Скопируйте в server/.env и заполните. Реальные значения — у тимлида, в git их нет.
PORT=8080
HOST=0.0.0.0

# Supabase: Project Settings -> API
SUPABASE_URL=https://ИД_ПРОЕКТА.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_ключ_из_Supabase

# Подпись токенов: любая длинная случайная строка (>= 16 символов)
JWT_SECRET=замените_на_длинную_случайную_строку

# Время жизни токенов
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# Демо-код входа (для хакатон-демо). Уберите строку — код придёт в Telegram.
DEMO_OTP=1111

# Канал доставки кодов: demo | telegram | twilio
SMS_PROVIDER=telegram

# Telegram-бот (коды входа и уведомления)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=moby_auth_bot
TELEGRAM_CHAT_ID=

# Twilio (если понадобится SMS вместо Telegram)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# CORS (необязательно)
CORS_ORIGIN=
