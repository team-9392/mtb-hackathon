# Скопируйте в server/.env и заполните. Реальные значения — у тимлида, в git их нет.
PORT=8080
HOST=0.0.0.0

# Supabase: Project Settings -> API
SUPABASE_URL=https://ИД_ПРОЕКТА.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_ключ_из_Supabase

# Подпись токенов: любая длинная случайная строка (>= 16 символов)
JWT_SECRET=замените_на_длинную_случайную_строку

# Время жизни токенов
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# Только для автотестов: писать реальный OTP-код в лог (OTP_DEBUG phone=... code=1234).
# На проде должно быть выключено или отсутствовать. В API код не отдаётся.
OTP_DEBUG=0

# Telegram-бот (единственный канал доставки кодов входа и уведомлений)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=moby_auth_bot
TELEGRAM_CHAT_ID=

# CORS (необязательно). Если пусто, разрешены только malanka.jaraslau.dev,
# localhost и туннели *.on.expo.app.
CORS_ORIGIN=
