{
  "expo": {
    "name": "Moby Family",
    "slug": "moby-family",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "by.moby.family",
      "appleTeamId": "F66252VQWS",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFC",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "by.moby.family",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "./plugins/remove-ios-push"
    ],
    "scheme": "mobyfamily",
    "extra": {
      "apiUrl": "https://malanka.jaraslau.dev/moby",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2faa0d4f-465a-493e-8e81-b97aeeead4f5"
      }
    },
    "owner": "jaraslaukunin-team"
  }
}
